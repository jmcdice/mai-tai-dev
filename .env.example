# Mai-Tai Environment Configuration
#
# You don't normally copy this by hand — `./dev.sh local up` creates .env from
# it on first run and fills in every blank REQUIRED value below with real
# randomness. The blanks are deliberate: a shipped default password is a
# password everyone already knows.

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=maitai
# REQUIRED — generated on first run. To make one by hand:
#   openssl rand -base64 36 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_PASSWORD=
POSTGRES_DB=maitai

# =============================================================================
# BACKEND
# =============================================================================
# Application environment (development, production)
APP_ENV=development

# Debug mode (true/false)
DEBUG=true

# REQUIRED — JWT signing key, generated on first run.
# Anyone who knows this can mint a token for any account, so it must never be
# a value that shipped in a public repo.
#   openssl rand -base64 32
SECRET_KEY=

# REQUIRED — Fernet key encrypting stored API keys/tokens at rest. Generated
# on first run. Rotating it makes every already-stored secret unreadable.
#   openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=

# Extra CORS origin (optional) - for LAN access, set to your machine's IP
# Example: http://192.168.1.100:3000
EXTRA_CORS_ORIGIN=

# =============================================================================
# FRONTEND
# =============================================================================
# Backend API URL (as seen from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (as seen from browser)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend URL for server-side calls (inside Docker network)
INTERNAL_API_URL=http://backend:8000

# =============================================================================
# OAUTH (Optional - for GitHub/Google sign-in)
# =============================================================================
# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED — NextAuth session secret, generated on first run.
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000


# =============================================================================
# AGENT CONTAINER AUTH (Optional - Vertex AI instead of an Anthropic key)
# =============================================================================
# When set, agent workspaces fall back to the host's Vertex AI credentials
# (~/.config/gcloud ADC) if the user has no Anthropic key in Settings > AI.
CLAUDE_CODE_USE_VERTEX=
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=global
# Model agents run. On Vertex use a full id (e.g. claude-opus-5); blank = 'sonnet'.
AGENT_MODEL=
