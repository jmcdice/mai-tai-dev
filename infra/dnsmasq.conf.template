# Rendered at container start with DNSMASQ_LISTEN_ADDRESS substituted in;
# see Dockerfile.dnsmasq. This used to hard-code one particular host's LAN
# address, so every other machine got a container in a restart loop.

# Don't read the host's resolv.conf or hosts file
no-resolv
no-hosts

# Bind only to the LAN IP — avoids conflict with systemd-resolved on 127.0.0.1:53
listen-address=__DNSMASQ_LISTEN_ADDRESS__
bind-interfaces

# Upstream DNS servers
server=8.8.8.8
server=8.8.4.4
server=1.1.1.1

# Resolve all *.mai-tai.dev (and mai-tai.dev itself) to this host on the LAN
address=/mai-tai.dev/__DNSMASQ_LISTEN_ADDRESS__

# Don't cache negative responses
no-negcache

# Log queries for debugging (comment out if too noisy)
log-queries
